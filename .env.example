# ==================================================
# INTELLIGENT CAMPUS CAREER AGENT — ENVIRONMENT CONFIG
# ==================================================

# FastAPI Backend Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Microsoft Foundry Project Configuration
FOUNDRY_PROJECT_ENDPOINT=https://your-foundry-project.cognitiveservices.azure.com/
FOUNDRY_AGENT_ID=agent-campus-career-v1
FOUNDRY_AGENT_NAME=CampusCareerAgent
FOUNDRY_API_VERSION=2024-05-01-preview

# Azure Authentication Configuration
AZURE_TENANT_ID=your-azure-tenant-id-placeholder
AZURE_CLIENT_ID=your-azure-client-id-placeholder
AZURE_CLIENT_SECRET=your-azure-client-secret-placeholder
AZURE_SUBSCRIPTION_ID=your-azure-subscription-id-placeholder
AZURE_RESOURCE_GROUP=your-azure-resource-group-placeholder

# Data Engine & Campus Knowledge Config
PLACEMENT_DATA_PATH=app/data/campus_placements.json
USE_MOCK_FOUNDRY_FALLBACK=true
